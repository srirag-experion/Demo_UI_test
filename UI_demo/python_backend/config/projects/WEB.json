{
  "project_id": "WEB",
  "name": "Customer Web Portal",
  "organization": "Astra Digital",
  "environment": "development",
  "enabled": true,
  "llm": {
    "provider": "google",
    "model": "gemini-2.5-pro",
    "temperature": 0.2,
    "max_tokens": 8192
  },
  "git": {
    "provider": "github",
    "owner": "Astra-Global",
    "repo": "customer-web-portal",
    "default_branch": "main",
    "target_branch": "development",
    "token": "ghp_web_token_77189",
    "enable_pr_comments": true,
    "auto_trigger_on_push": true
  },
  "jira": {
    "base_url": "https://astratech.atlassian.net",
    "email": "frontend-bot@astratech.internal",
    "api_token": "ATATT3xFfGF0d-frontend",
    "project_key": "WEB",
    "issue_type": "Task",
    "trigger_status": "Ready for Agent",
    "status_working": "Agent Working",
    "status_pr_created": "PR Created",
    "status_failed": "Agent Failed"
  },
  "test_runner": {
    "framework": "vitest",
    "config_path": "./vitest.config.ts",
    "test_command": "npm test",
    "lint_command": "npm run lint",
    "build_command": "npm run build",
    "timeout_minutes": 5
