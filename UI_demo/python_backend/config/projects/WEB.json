  "rag": {
    "docs_path": "./docs,./src/components",
    "chroma_collection": "project-docs-WEB",
    "embedding_model": "text-embedding-3-small",
    "chunk_size": 512,
    "chunk_overlap": 64
  },
  "goose": {
    "model": "gemini-2.5-pro",
    "autonomy_level": "full-autonomous",
    "sandbox_dir": "/workspace/customer-web-portal",
    "max_iterations": 30,
    "require_approval_for_dangerous_commands": false
  },
  "notifications": {
    "slack_webhook_url": "https://hooks.slack.com/services/T00/B00/WEB",
    "slack_channel": "#frontend-reviews",
    "notify_on_failure": true,
    "notify_on_pr": true
  }
